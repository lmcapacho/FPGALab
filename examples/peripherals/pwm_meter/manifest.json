{
  "api_version": 1,
  "id": "pwm_meter",
  "package": {
    "version": "1.0.0",
    "author": {
      "name": "Luis Miguel Capacho",
      "url": "https://github.com/lmcapacho/FPGALab"
    },
    "license": "AGPL-3.0-or-later",
    "repository": "https://github.com/lmcapacho/FPGALab",
    "compatibility": {"minimum_fpgalab": "0.1.0rc4"}
  },
  "label": "PWM meter",
  "category": "output",
  "description": "Measures the high-time percentage of a digital FPGA output over each virtual-time update window.",
  "keywords": ["pwm", "duty cycle", "meter", "temporal", "output"],
  "icon": "icon.svg",
  "simulation": {"class": "gpio_temporal", "temporal": {"mode": "per_terminal"}},
  "terminals": [
    {"name": "signal", "direction": "output", "width": 1, "required": true}
  ],
  "properties": {},
  "visual": {
    "renderer": "measured_svg",
    "size": [132, 94],
    "chrome": "compact",
    "terminal": "signal",
    "measurement": "duty_cycle",
    "input_range": [0, 1],
    "output_range": [0, 1],
    "transform": "scale_x",
    "origin": [12, 54],
    "base_svg": "body.svg",
    "moving_svg": "fill.svg",
    "value_label": {"format": "percent", "rect": [12, 10, 108, 30]}
  }
}
