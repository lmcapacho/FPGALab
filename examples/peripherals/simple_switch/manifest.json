{
  "api_version": 1,
  "id": "simple_switch",
  "package": {
    "version": "1.0.0",
    "author": {
      "name": "Luis Miguel Capacho and contributors",
      "url": "https://github.com/lmcapacho/FPGALab"
    },
    "license": "AGPL-3.0-or-later",
    "repository": "https://github.com/lmcapacho/FPGALab",
    "compatibility": {"minimum_fpgalab": "0.1.0rc3"}
  },
  "label": "Simple switch",
  "category": "input",
  "description": "Minimal interactive peripheral built only from a manifest and SVG states.",
  "keywords": ["switch", "toggle", "input", "state", "svg"],
  "icon": "icon.svg",
  "simulation": {"class": "gpio_driven"},
  "terminals": [
    {"name": "signal", "direction": "input", "required": true}
  ],
  "properties": {},
  "visual": {
    "renderer": "state_svg",
    "size": [112, 82],
    "chrome": "compact",
    "states": {
      "off": "off.svg",
      "on": "on.svg"
    },
    "default_state": "off",
    "state_rules": [
      {"state": "on", "when": {"terminal": "signal", "equals": 1}}
    ],
    "interactions": [
      {
        "event": "click",
        "region": [12, 8, 88, 42],
        "terminal": "signal",
        "action": "toggle"
      }
    ]
  }
}
