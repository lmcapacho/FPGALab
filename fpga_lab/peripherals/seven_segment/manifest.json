{
  "id": "seven_segment",
  "label": "Seven-segment display",
  "category": "output",
  "simulation": {
    "class": "gpio_temporal",
    "temporal": {
      "mode": "display_common",
      "common_terminal": "common",
      "active_terminals": ["a", "b", "c", "d", "e", "f", "g"],
      "polarity_property": "common"
    }
  },
  "terminals": [
    { "name": "a", "direction": "output", "width": 1, "required": true },
    { "name": "b", "direction": "output", "width": 1, "required": true },
    { "name": "c", "direction": "output", "width": 1, "required": true },
    { "name": "d", "direction": "output", "width": 1, "required": true },
    { "name": "e", "direction": "output", "width": 1, "required": true },
    { "name": "f", "direction": "output", "width": 1, "required": true },
    { "name": "g", "direction": "output", "width": 1, "required": true },
    { "name": "common", "direction": "output", "width": 1, "required": true, "supplies": ["GND", "VCC"] }
  ],
  "properties": {
    "common": {
      "type": "enum",
      "values": ["cathode", "anode"],
      "default": "cathode",
      "label": "Common"
    },
    "color": {
      "type": "color",
      "default": "#ff3b30",
      "label": "Color"
    }
  },
  "visual": { "renderer": "seven_segment", "size": [150, 205] }
}
